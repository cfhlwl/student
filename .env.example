DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://collect.example.edu.cn
SITE_NAME=赤峰一中学生资料采集
SITE_URL=https://collect.example.edu.cn
MAX_UPLOAD_SIZE_MB=20
MAX_PHOTOS_PER_SUBMISSION=300
MAX_DOCUMENTS_PER_SUBMISSION=10
MAX_PHOTOS_PER_BATCH=20
MAX_DOCUMENTS_PER_BATCH=10
MAX_BATCH_UPLOAD_SIZE_MB=32
DATA_UPLOAD_MAX_NUMBER_FILES=40
DATA_UPLOAD_MAX_MEMORY_SIZE_MB=40
SQLITE_BUSY_TIMEOUT_SECONDS=30
EXPORT_TEMP_DIR=/app/data/exports
MAX_STORAGE_MB=4096
DATA_RETENTION_DAYS=365
UPLOAD_FINALIZING_TIMEOUT_SECONDS=300
DATABASE_PATH=/app/data/db.sqlite3
MEDIA_ROOT=/app/media
HTTPS_ENABLED=1
TRUSTED_PROXY_NETWORKS=127.0.0.1/32,::1/128,172.16.0.0/12
SECURITY_RATE_LIMIT_CACHE_DIR=/app/data/rate-limit-cache

